{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "module": "node20",
    "noEmit": false,
    "outDir": "./build",
    "paths": {
      "@server": ["./src/server/"],
      "@shared": ["./src/shared/"]
    },
    "strict": true,
    "target": "es2025",
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["./src/**/*"]
}
